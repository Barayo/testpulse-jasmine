{
  "name": "testpulse-jasmine",
  "version": "0.1.0",
  "description": "Jasmine reporter + check CLI for reporting test results into TestPulse",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Barayo/testpulse-jasmine.git"
  },
  "homepage": "https://github.com/Barayo/testpulse-jasmine#readme",
  "bugs": "https://github.com/Barayo/testpulse-jasmine/issues",
  "keywords": [
    "jasmine",
    "jasmine-reporter",
    "testpulse",
    "junit",
    "test-management"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "testpulse-jasmine": "dist/bin/check.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --selectProjects unit",
    "test:e2e": "npm run build && jest --selectProjects e2e",
    "test:all": "npm run build && jest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "jasmine": ">=5.0.0"
  },
  "devDependencies": {
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.9",
    "jasmine": "^5.5.0",
    "jest": "^29.7.0",
    "msw": "^2.6.6",
    "semantic-release": "^24.2.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
